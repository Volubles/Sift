# Rust application: keep Cargo.lock tracked when the application is created.
/target/
/dist/

# Private libraries, runtime state, exports, and measurement output.
/.local/
/.sift/
/samples/
/exports/
/benchmarks/results/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log

# Local secrets. A reviewed, non-secret example may be tracked.
.env
.env.*
!.env.example

# IDE and operating-system state.
/.idea/
/.vscode/
*.iml
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Audio extensions are deliberately not ignored globally: small, licensed
# regression fixtures may eventually belong in tests/fixtures/.
